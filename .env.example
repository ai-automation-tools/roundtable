# Copy to .env (gitignored) and fill in. A real environment variable of the
# same name overrides the file. scripts/db_sync.py reads the sync settings;
# the web UI reads AGENT_CHAT_ALLOWED_HOSTS (at startup) and the two
# AgentBattleground settings at the bottom (per request, no restart needed).

# Extra host names the web UI answers to, comma-separated. 127.0.0.1 and
# localhost are always allowed; any other Host header gets 400. Add your
# `tailscale serve` MagicDNS name here (the part after http:// in the URL your
# phone opens, e.g. mypc.tailnet-1234.ts.net) if the phone shows
# "Invalid host header". Restart the web UI after changing it.
AGENT_CHAT_ALLOWED_HOSTS=

# Shared SQLite DB. Leave unset for the default, <repo>/db/chat.db.
AGENT_CHAT_DB=

# Base URL of the hosted web UI the sidecar mirrors to, e.g. https://agent-chat.mikesailab.com
AGENT_CHAT_REMOTE_URL=

# Bearer token for /api/ingest. Must match the Fly secret of the same name
# (fly secrets list --app agent-chat-mikesailab shows it is set, not its value).
AGENT_CHAT_INGEST_TOKEN=

# AgentBattleground bridge (/api/battleground/*). Both are required for the
# browser extension to reach this server; leave them empty if you don't use it.
# A long random string of your choosing; paste the same value into the
# extension panel's Settings. With none set the bridge refuses every call.
AGENT_CHAT_BATTLEGROUND_TOKEN=
# The extension's id, comma-separated if you run it in more than one browser:
# the ID on chrome://extensions, or the Internal UUID Firefox shows in
# about:debugging. Any other extension is refused like any other website.
AGENT_CHAT_EXTENSION_IDS=
