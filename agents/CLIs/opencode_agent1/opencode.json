{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "deny",
    "read": "allow",
    "roundtable_*": "allow",
    "external_directory": {
      "*": "deny",
      "*/db/launch/*": "allow",
      "*\\db\\launch\\*": "allow"
    }
  },
  "mcp": {
    "roundtable": {
      "type": "local",
      "enabled": true,
      "command": [
        "pwsh",
        "-NoProfile",
        "-File",
        "<repo>/scripts/run-mcp-server.ps1",
        "opencode"
      ]
    }
  }
}
